@@ -0,0 +1,278 @@
+"""ChEMBL connector for M4 ligand candidate collection.
+
+Uses the current ChEMBL REST API (``https://www.ebi.ac.uk/chembl/api/data/``), confirmed against
+ChEMBL's own documentation (chembl.gitbook.io) and the EBI web services. No API key needed. Goes
+through ``s2f.common.http.CachedJsonClient`` -- unlike the ESMC SDK case, this is a plain GET-JSON
+REST API, so the shared cached/retried/offline-replayable client applies directly, no separate
+wrapper needed.
+
+Two ways in per protein:
+
+1. **Fast path**: if M2 already resolved a ChEMBL target ID for this protein's UniProt entry
+   (``s2f.common.ids`` populates ``Xrefs.chembl`` from UniProt's own ChEMBL cross-reference when
+   ``--map-ids`` ran), that ID is used directly -- no extra target-lookup call needed, and no new
+   ID mapping is invented (pitfall #11: nothing here does its own ID mapping).
+2. **Fallback**: given a bare UniProt accession with no pre-resolved ChEMBL cross-reference, looks
+   up the target via ``target?target_components__accession={accession}``.
+
+For each ChEMBL target: fetches approved-drug mechanism-of-action records
+(``mechanism?target_chembl_id=``) and significant bioactivities
+(``activity?target_chembl_id=...&pchembl_value__isnull=false``), then batches molecule lookups
+(``molecule?molecule_chembl_id__in=...``) for SMILES / max_phase / preferred name.
+"""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import Any, Iterable
+
+from ...common.http import CachedJsonClient, HttpError
+from ..models import (
+    TARGETS_VIA_CHEMBL_DIRECT,
+    TARGETS_VIA_CHEMBL_HOMOLOG,
+    LigandCandidate,
+    ProvenanceRecord,
+)
+from ..normalize import InvalidSmiles, normalize_smiles
+
+BASE_URL = "https://www.ebi.ac.uk/chembl/api/data"
+ACTIVITY_PCHEMBL_MIN = 5.0  # pChEMBL >= 5 corresponds to potency <= ~10 uM; a common screening cut
+MOLECULE_BATCH = 50
+
+
+def _now() -> str:
+    return datetime.now(UTC).isoformat()
+
+
+def find_target_chembl_id(client: CachedJsonClient, uniprot_accession: str) -> str | None:
+    """Fallback target lookup by UniProt accession, when no cross-reference was pre-resolved."""
+    payload = client.get_json(
+        "chembl_target",
+        f"{BASE_URL}/target.json",
+        {"target_components__accession": uniprot_accession, "target_type": "SINGLE PROTEIN", "limit": 1},
+    )
+    targets = (payload or {}).get("targets") or []
+    return str(targets[0]["target_chembl_id"]) if targets else None
+
+
+def fetch_mechanisms(client: CachedJsonClient, target_chembl_id: str) -> list[dict[str, Any]]:
+    payload = client.get_json(
+        "chembl_mechanism", f"{BASE_URL}/mechanism.json", {"target_chembl_id": target_chembl_id, "limit": 100}
+    )
+    return list((payload or {}).get("mechanisms") or [])
+
+
+def fetch_activities(client: CachedJsonClient, target_chembl_id: str, *, min_pchembl: float = ACTIVITY_PCHEMBL_MIN) -> list[dict[str, Any]]:
+    payload = client.get_json(
+        "chembl_activity",
+        f"{BASE_URL}/activity.json",
+        {
+            "target_chembl_id": target_chembl_id,
+            "pchembl_value__gte": min_pchembl,
+            "assay_type": "B",
+            "limit": 100,
+        },
+    )
+    return list((payload or {}).get("activities") or [])
+
+
+def fetch_molecules(client: CachedJsonClient, molecule_chembl_ids: Iterable[str]) -> dict[str, dict[str, Any]]:
+    """Batched molecule lookup: canonical_smiles, max_phase, pref_name."""
+    unique = sorted({m for m in molecule_chembl_ids if m})
+    out: dict[str, dict[str, Any]] = {}
+    for start in range(0, len(unique), MOLECULE_BATCH):
+        batch = unique[start : start + MOLECULE_BATCH]
+        payload = client.get_json(
+            "chembl_molecule",
+            f"{BASE_URL}/molecule.json",
+            {"molecule_chembl_id__in": ",".join(batch), "limit": MOLECULE_BATCH},
+        )
+        for molecule in (payload or {}).get("molecules") or []:
+            chembl_id = str(molecule.get("molecule_chembl_id") or "")
+            if chembl_id:
+                out[chembl_id] = molecule
+    return out
+
+
+def _molecule_smiles(molecule: dict[str, Any]) -> str:
+    structures = molecule.get("molecule_structures") or {}
+    return str(structures.get("canonical_smiles") or "")
+
+
+def _approval_status(molecule: dict[str, Any]) -> str:
+    max_phase = molecule.get("max_phase")
+    if max_phase == 4:
+        return "approved"
+    if max_phase in (1, 2, 3):
+        return "investigational"
+    return ""
+
+
+def collect_from_chembl(
+    client: CachedJsonClient,
+    *,
+    feature_id: str,
+    target_chembl_id: str | None,
+    uniprot_accession: str = "",
+    via_homolog: bool,
+    max_phase: int | None = None,
+) -> tuple[list[LigandCandidate], list[dict[str, Any]]]:
+    """Collect candidates for one protein's already-resolved ChEMBL target.
+
+    ``via_homolog`` says whether ``target_chembl_id``/``uniprot_accession`` came from the
+    protein's own mapping or from a PDB-homolog's (M2's ``xrefs.route == "pdb_hit"``) -- this
+    decides ``targets_via`` (see the "targets_via note" in ``models.py``).
+
+    Returns (candidates, failures). Failures are recorded, never silently dropped (project
+    convention from M2's ``run.json['failures']``).
+    """
+    failures: list[dict[str, Any]] = []
+    targets_via = TARGETS_VIA_CHEMBL_HOMOLOG if via_homolog else TARGETS_VIA_CHEMBL_DIRECT
+
+    resolved_target = target_chembl_id
+    if resolved_target is None:
+        if not uniprot_accession:
+            failures.append({"feature_id": feature_id, "error": "no chembl_target_id and no uniprot_accession to look one up"})
+            return [], failures
+        try:
+            resolved_target = find_target_chembl_id(client, uniprot_accession)
+        except HttpError as exc:
+            failures.append({"feature_id": feature_id, "error": str(exc)})
+            return [], failures
+        if resolved_target is None:
+            return [], failures  # a genuine "ChEMBL has no target for this accession", not a failure
+
+    try:
+        mechanisms = fetch_mechanisms(client, resolved_target)
+        activities = fetch_activities(client, resolved_target)
+    except HttpError as exc:
+        failures.append({"feature_id": feature_id, "target_chembl_id": resolved_target, "error": str(exc)})
+        return [], failures
+
+    molecule_ids = {m.get("molecule_chembl_id") for m in mechanisms} | {a.get("molecule_chembl_id") for a in activities}
+    try:
+        molecules = fetch_molecules(client, (m for m in molecule_ids if m))
+    except HttpError as exc:
+        failures.append({"feature_id": feature_id, "target_chembl_id": resolved_target, "error": str(exc)})
+        return [], failures
+
+    candidates: list[LigandCandidate] = []
+    retrieved_at = _now()
+
+    for mechanism in mechanisms:
+        molecule_id = str(mechanism.get("molecule_chembl_id") or "")
+        molecule = molecules.get(molecule_id)
+        if not molecule:
+            failures.append({"feature_id": feature_id, "molecule_chembl_id": molecule_id, "error": "mechanism referenced a molecule with no molecule record"})
+            continue
+        smiles = _molecule_smiles(molecule)
+        if not smiles:
+            failures.append({"feature_id": feature_id, "molecule_chembl_id": molecule_id, "error": "no canonical_smiles on molecule record"})
+            continue
+        try:
+            normalized = normalize_smiles(smiles)
+        except InvalidSmiles as exc:
+            failures.append({"feature_id": feature_id, "molecule_chembl_id": molecule_id, "error": str(exc)})
+            continue
+
+        approval = _approval_status(molecule)
+        if max_phase is not None and (molecule.get("max_phase") or 0) < max_phase:
+            # Below the caller's phase floor: keep it out of the "approved candidate" pool but
+            # do not silently drop the observation -- record it and move on.
+            continue
+
+        candidates.append(
+            LigandCandidate(
+                for_feature_id=feature_id,
+                ligand_id=normalized.inchikey,
+                canonical_smiles=normalized.canonical_smiles,
+                name=str(molecule.get("pref_name") or ""),
+                source=["chembl"],
+                approval_status=approval,
+                targets_via=[targets_via],
+                proposal_reason=[
+                    {
+                        "type": "mechanism_of_action",
+                        "source": "chembl",
+                        "evidence_id": mechanism.get("mechanism_id", ""),
+                        "description": f"ChEMBL mechanism-of-action record against target {resolved_target}: "
+                        f"{mechanism.get('mechanism_of_action', '')}",
+                    }
+                ],
+                provenance=[
+                    ProvenanceRecord(
+                        source="chembl",
+                        source_record_id=str(mechanism.get("mechanism_id") or molecule_id),
+                        retrieved_at=retrieved_at,
+                        evidence_type="mechanism_of_action",
+                        source_url=f"https://www.ebi.ac.uk/chembl/explore/compound/{molecule_id}",
+                        description=str(mechanism.get("mechanism_of_action") or ""),
+                    )
+                ],
+                activity_evidence=[],
+            )
+        )
+
+    for activity in activities:
+        molecule_id = str(activity.get("molecule_chembl_id") or "")
+        molecule = molecules.get(molecule_id)
+        if not molecule:
+            failures.append({"feature_id": feature_id, "molecule_chembl_id": molecule_id, "error": "activity referenced a molecule with no molecule record"})
+            continue
+        smiles = _molecule_smiles(molecule)
+        if not smiles:
+            failures.append({"feature_id": feature_id, "molecule_chembl_id": molecule_id, "error": "no canonical_smiles on molecule record"})
+            continue
+        try:
+            normalized = normalize_smiles(smiles)
+        except InvalidSmiles as exc:
+            failures.append({"feature_id": feature_id, "molecule_chembl_id": molecule_id, "error": str(exc)})
+            continue
+
+        if max_phase is not None and (molecule.get("max_phase") or 0) < max_phase:
+            # Same phase floor as the mechanism loop above -- an activity-only observation on a
+            # below-threshold molecule must not sneak past the cap that route enforces.
+            continue
+
+        candidates.append(
+            LigandCandidate(
+                for_feature_id=feature_id,
+                ligand_id=normalized.inchikey,
+                canonical_smiles=normalized.canonical_smiles,
+                name=str(molecule.get("pref_name") or ""),
+                source=["chembl"],
+                approval_status=_approval_status(molecule),
+                targets_via=[targets_via],
+                proposal_reason=[
+                    {
+                        "type": "direct_target_activity",
+                        "source": "chembl",
+                        "evidence_id": activity.get("activity_id", ""),
+                        "description": f"ChEMBL bioactivity record against target {resolved_target}, "
+                        f"pChEMBL {activity.get('pchembl_value', '')}",
+                    }
+                ],
+                provenance=[
+                    ProvenanceRecord(
+                        source="chembl",
+                        source_record_id=str(activity.get("activity_id") or ""),
+                        retrieved_at=retrieved_at,
+                        evidence_type="target_activity",
+                        source_url=f"https://www.ebi.ac.uk/chembl/explore/compound/{molecule_id}",
+                        description=f"pChEMBL {activity.get('pchembl_value', '')}, assay {activity.get('assay_chembl_id', '')}",
+                    )
+                ],
+                activity_evidence=[
+                    {
+                        "type": "pchembl_value",
+                        "value": activity.get("pchembl_value"),
+                        "assay_chembl_id": activity.get("assay_chembl_id", ""),
+                        "standard_type": activity.get("standard_type", ""),
+                        "standard_value": activity.get("standard_value"),
+                        "standard_units": activity.get("standard_units", ""),
+                    }
+                ],
+            )
+        )
+
+    return candidates, failures

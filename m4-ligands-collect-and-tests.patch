+"""Tests for s2f.m4_ligands.normalize (RDKit canonicalization)."""
+
+from __future__ import annotations
+
+import pytest
+
+from s2f.m4_ligands.normalize import InvalidSmiles, normalize_smiles
+
+
+def test_valid_smiles_produces_canonical_form_and_inchikey() -> None:
+    # Aspirin
+    result = normalize_smiles("CC(=O)Oc1ccccc1C(=O)O")
+    assert result.inchikey == "BSYNRYMUTXBXSQ-UHFFFAOYSA-N"
+    assert result.canonical_smiles  # RDKit's own canonical form; not asserting exact string
+
+
+def test_two_equivalent_smiles_collapse_to_the_same_inchikey() -> None:
+    """The whole point of normalization: different-looking SMILES for the same molecule must
+    dedupe. Two ways of writing ethanol."""
+    a = normalize_smiles("CCO")
+    b = normalize_smiles("OCC")
+    assert a.inchikey == b.inchikey
+    assert a.canonical_smiles == b.canonical_smiles
+
+
+def test_invalid_smiles_raises_rather_than_guessing() -> None:
+    with pytest.raises(InvalidSmiles):
+        normalize_smiles("not a smiles string!!!")
+
+
+def test_empty_smiles_raises() -> None:
+    with pytest.raises(InvalidSmiles):
+        normalize_smiles("")

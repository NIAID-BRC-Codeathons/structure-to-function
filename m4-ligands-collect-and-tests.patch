+"""Tests for s2f.m4_ligands.dedup (dedup key = (for_feature_id, ligand_id), evidence-merging)."""
+
+from __future__ import annotations
+
+import pytest
+
+from s2f.m4_ligands.dedup import deduplicate, merge_candidate
+from s2f.m4_ligands.models import LigandCandidate, ProvenanceRecord
+
+
+def make_candidate(feature_id: str, ligand_id: str, source: str, **kwargs) -> LigandCandidate:
+    defaults = dict(
+        for_feature_id=feature_id,
+        ligand_id=ligand_id,
+        canonical_smiles="CCO",
+        source=[source],
+        provenance=[ProvenanceRecord(source=source, source_record_id="1", retrieved_at="t", evidence_type="e")],
+    )
+    defaults.update(kwargs)
+    return LigandCandidate(**defaults)
+
+
+def test_different_proteins_are_never_merged_even_with_the_same_ligand() -> None:
+    a = make_candidate("fig|1", "INCHIKEY-A", "chembl")
+    b = make_candidate("fig|2", "INCHIKEY-A", "chembl")
+
+    result = deduplicate([a, b])
+
+    assert len(result) == 2
+
+
+def test_same_protein_and_ligand_from_two_sources_merge_into_one_with_both_provenance_records() -> None:
+    a = make_candidate("fig|1", "INCHIKEY-A", "chembl")
+    b = make_candidate("fig|1", "INCHIKEY-A", "bindingdb")
+
+    result = deduplicate([a, b])
+
+    assert len(result) == 1
+    merged = result[0]
+    assert set(merged.source) == {"chembl", "bindingdb"}
+    assert len(merged.provenance) == 2  # both observations kept, neither discarded
+
+
+def test_targets_via_is_unioned_not_overwritten() -> None:
+    a = make_candidate("fig|1", "INCHIKEY-A", "chembl", targets_via=["chembl_direct"])
+    b = make_candidate("fig|1", "INCHIKEY-A", "chembl", targets_via=["kg"])
+
+    result = deduplicate([a, b])
+
+    assert set(result[0].targets_via) == {"chembl_direct", "kg"}
+
+
+def test_name_and_approval_status_are_filled_from_whichever_record_has_them() -> None:
+    a = make_candidate("fig|1", "INCHIKEY-A", "chembl", name="", approval_status="")
+    b = make_candidate("fig|1", "INCHIKEY-A", "bindingdb", name="Aspirin", approval_status="approved")
+
+    result = deduplicate([a, b])
+
+    assert result[0].name == "Aspirin"
+    assert result[0].approval_status == "approved"
+
+
+def test_output_order_is_stable_first_seen_wins_as_the_base_record() -> None:
+    a = make_candidate("fig|1", "INCHIKEY-A", "chembl")
+    b = make_candidate("fig|2", "INCHIKEY-B", "chembl")
+    c = make_candidate("fig|1", "INCHIKEY-A", "bindingdb")  # merges into `a`
+
+    result = deduplicate([a, b, c])
+
+    assert [r.dedup_key for r in result] == [("fig|1", "INCHIKEY-A"), ("fig|2", "INCHIKEY-B")]
+
+
+def test_merge_candidate_rejects_mismatched_dedup_keys() -> None:
+    a = make_candidate("fig|1", "INCHIKEY-A", "chembl")
+    b = make_candidate("fig|2", "INCHIKEY-B", "chembl")
+
+    with pytest.raises(ValueError):
+        merge_candidate(a, b)

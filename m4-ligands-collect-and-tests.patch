+++ b/s2f/m4_ligands/cli.py
@@ -0,0 +1,207 @@
+"""M4 step 1 CLI: collect_ligands() from ChEMBL for M2's selected proteins.
+
+    python -m s2f.m4_ligands.cli --run runs/<id> [--protein-id fig|...] [--max-phase 4]
+        [--offline] [--dry-run]
+
+Reads ``<run>/m2_pdb/proteins.tsv`` (real, existing -- NOT ``m3_proteins/proteins.tsv``, which
+does not correspond to anything in this codebase: M3 has no code yet, only ``docs/03-m3-fold.md``).
+Requires the ``--map-ids`` xref columns (``uniprot``, ``uniprot_route``, ``chembl``) to have been
+written by ``s2f.m2_triage --map-ids`` -- a protein with no UniProt mapping is skipped and
+recorded, never silently dropped, per the project's ID-mapping pitfall (#11: nothing here invents
+a mapping; it only reads what ``s2f.common.ids`` already resolved).
+
+Only implements docs/04-m4-ligands.md step 1 (``collect_ligands()``), and only the ChEMBL source
+of the several the doc lists. See the module docstrings in ``sources/chembl.py``, ``models.py``
+and ``dedup.py`` for what's implemented and what's deliberately left for later steps.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import time
+from datetime import UTC, datetime
+from pathlib import Path
+
+from ..common.http import CachedJsonClient, JsonCache
+from .dedup import deduplicate
+from .models import LigandCandidate
+from .sources.chembl import collect_from_chembl
+
+FIXTURE_DIR = Path(__file__).resolve().parents[2] / "fixtures" / "m4"
+
+
+def load_m2_proteins(path: Path) -> list[dict[str, str]]:
+    with path.open(encoding="utf-8", newline="") as handle:
+        return list(csv.DictReader(handle, delimiter="\t"))
+
+
+def eligible_targets(rows: list[dict[str, str]], protein_id: str = "") -> list[dict[str, str]]:
+    """Proteins with a usable ChEMBL route: a resolved chembl xref, or at least a uniprot
+    accession to look one up from. Rows with neither are returned too, tagged, so they are
+    visible in the run manifest rather than silently absent from the output."""
+    rows = [r for r in rows if not protein_id or r.get("feature_id") == protein_id]
+    return rows
+
+
+def run(args: argparse.Namespace) -> int:
+    run_dir = Path(args.run)
+    proteins_path = Path(args.proteins) if args.proteins else run_dir / "m2_pdb" / "proteins.tsv"
+    if args.dry_run:
+        proteins_path = FIXTURE_DIR / "proteins.tsv"
+    out_dir = run_dir / "m4_ligands"
+
+    started = datetime.now(UTC)
+    clock = time.monotonic()
+
+    rows = load_m2_proteins(proteins_path) if proteins_path.exists() else []
+    rows = eligible_targets(rows, args.protein_id)
+
+    offline = args.offline or args.dry_run
+    cache_path = Path(args.cache) if args.cache else (FIXTURE_DIR / "cache.sqlite" if args.dry_run else run_dir / "cache" / "m4_ligands.sqlite")
+
+    all_candidates: list[LigandCandidate] = []
+    failures: list[dict] = []
+    skipped_no_mapping: list[str] = []
+
+    with JsonCache(cache_path) as cache:
+        client = CachedJsonClient(cache=cache, offline=offline)
+
+        for row in rows:
+            feature_id = row.get("feature_id", "")
+            uniprot = (row.get("uniprot") or "").strip()
+            uniprot_route = (row.get("uniprot_route") or "").strip()
+            chembl_targets = [t for t in (row.get("chembl") or "").split(";") if t]
+
+            if not uniprot and not chembl_targets:
+                skipped_no_mapping.append(feature_id)
+                continue
+
+            via_homolog = uniprot_route == "pdb_hit"
+            if chembl_targets:
+                for target_chembl_id in chembl_targets:
+                    candidates, target_failures = collect_from_chembl(
+                        client,
+                        feature_id=feature_id,
+                        target_chembl_id=target_chembl_id,
+                        uniprot_accession=uniprot,
+                        via_homolog=via_homolog,
+                        max_phase=args.max_phase,
+                    )
+                    all_candidates.extend(candidates)
+                    failures.extend(target_failures)
+            else:
+                candidates, target_failures = collect_from_chembl(
+                    client,
+                    feature_id=feature_id,
+                    target_chembl_id=None,
+                    uniprot_accession=uniprot,
+                    via_homolog=via_homolog,
+                    max_phase=args.max_phase,
+                )
+                all_candidates.extend(candidates)
+                failures.extend(target_failures)
+
+        deduped = deduplicate(all_candidates)
+
+        out_dir.mkdir(parents=True, exist_ok=True)
+        with (out_dir / "ligand_candidates.jsonl").open("w", encoding="utf-8") as handle:
+            for candidate in deduped:
+                handle.write(json.dumps(candidate.as_dict()) + "\n")
+
+        with (out_dir / "provenance.jsonl").open("w", encoding="utf-8") as handle:
+            for candidate in deduped:
+                for record in candidate.provenance:
+                    handle.write(
+                        json.dumps(
+                            {
+                                "feature_id": candidate.for_feature_id,
+                                "ligand_id": candidate.ligand_id,
+                                **record.as_dict(),
+                            }
+                        )
+                        + "\n"
+                    )
+
+        source_observations: dict[str, int] = {}
+        source_unique: dict[str, set[str]] = {}
+        for candidate in deduped:
+            for source in candidate.source:
+                source_unique.setdefault(source, set()).add(candidate.dedup_key[1])
+        for candidate in all_candidates:  # pre-dedup: every observation, not just unique candidates
+            for source in candidate.source:
+                source_observations[source] = source_observations.get(source, 0) + 1
+
+        manifest = {
+            "module": "m4_ligands_collect",
+            "docs": "docs/04-m4-ligands.md",
+            "implements": "step 1 (collect_ligands()) only; steps 2-6 not implemented",
+            "sources_enabled": ["chembl"],
+            "started_utc": started.isoformat(),
+            "finished_utc": datetime.now(UTC).isoformat(),
+            "elapsed_seconds": round(time.monotonic() - clock, 2),
+            "input_proteins": str(proteins_path),
+            "output_dir": str(out_dir),
+            "cache_path": str(cache_path),
+            "offline": offline,
+            "dry_run": args.dry_run,
+            "max_phase_filter": args.max_phase,
+            "counts": {
+                "proteins_considered": len(rows),
+                "proteins_skipped_no_mapping": len(skipped_no_mapping),
+                "candidates_raw": len(all_candidates),
+                "candidates_deduplicated": len(deduped),
+                "by_source": {
+                    source: {"unique_candidates": len(ids), "source_observations": source_observations.get(source, 0)}
+                    for source, ids in source_unique.items()
+                },
+            },
+            "skipped_no_mapping": skipped_no_mapping,
+            "failures": failures,
+        }
+        (out_dir / "run.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
+
+    print(
+        f"{len(rows)} proteins considered, {len(skipped_no_mapping)} skipped (no UniProt/ChEMBL mapping), "
+        f"{len(all_candidates)} raw candidates -> {len(deduped)} after dedup."
+    )
+    print(f"Wrote {out_dir}")
+    if failures:
+        print(f"Warning: {len(failures)} source-level failures recorded in run.json.")
+    return 0
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(prog="python -m s2f.m4_ligands.cli", description=__doc__)
+    parser.add_argument("--run", default="runs/dev", help="run directory (reads <run>/m2_pdb/proteins.tsv, writes <run>/m4_ligands)")
+    parser.add_argument("--proteins", default="", help="override the M2 proteins.tsv path")
+    parser.add_argument("--protein-id", default="", help="run one protein only (development)")
+    parser.add_argument("--max-phase", type=int, default=None, help="only keep candidates at or above this ChEMBL max_phase")
+    parser.add_argument("--cache", default="", help="override the SQLite cache path")
+    parser.add_argument("--offline", action="store_true", help="replay from cache; never call the network")
+    parser.add_argument("--dry-run", action="store_true", help="run from fixtures/m4 with no network")
+    # --sources is accepted for forward-compatibility with the doc's CLI sketch, but only
+    # "chembl" is implemented; anything else is rejected rather than silently ignored.
+    parser.add_argument("--sources", default="chembl", help="comma-separated sources (only 'chembl' is implemented)")
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    requested = {s.strip() for s in args.sources.split(",") if s.strip()}
+    unsupported = requested - {"chembl"}
+    if unsupported:
+        print(f"Error: unsupported source(s) {sorted(unsupported)} -- only 'chembl' is implemented so far.")
+        return 2
+    if args.dry_run and args.run == "runs/dev":
+        args.run = "runs/dry-run"
+    try:
+        return run(args)
+    except (OSError, ValueError) as exc:
+        print(f"Error: {exc}")
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/s2f/m4_ligands/dedup.py b/s2f/m4_ligands/dedup.py
new file mode 100644
index 0000000..117a320
--- /dev/null
+++ b/s2f/m4_ligands/dedup.py
@@ -0,0 +1,55 @@
+"""Deduplicate ligand candidates by (feature_id, InChIKey), merging evidence rather than
+picking one source and discarding the rest.
+
+A ligand found via both a ChEMBL activity row and a ChEMBL mechanism-of-action row becomes one
+candidate with two provenance records and a unioned ``targets_via`` / ``source`` list -- never
+two separate candidates, and never a single provenance record that hides the other observation.
+"""
+
+from __future__ import annotations
+
+from typing import Iterable
+
+from .models import LigandCandidate
+
+
+def _merge_unique(existing: list[str], new: Iterable[str]) -> list[str]:
+    merged = list(existing)
+    for item in new:
+        if item not in merged:
+            merged.append(item)
+    return merged
+
+
+def merge_candidate(target: LigandCandidate, incoming: LigandCandidate) -> None:
+    """Merge ``incoming`` into ``target`` in place. Both must share a dedup_key."""
+    if target.dedup_key != incoming.dedup_key:
+        raise ValueError(f"cannot merge candidates with different dedup keys: {target.dedup_key} != {incoming.dedup_key}")
+
+    target.source = _merge_unique(target.source, incoming.source)
+    target.targets_via = _merge_unique(target.targets_via, incoming.targets_via)
+    target.proposal_reason.extend(incoming.proposal_reason)
+    target.provenance.extend(incoming.provenance)
+    target.activity_evidence.extend(incoming.activity_evidence)
+    if not target.name and incoming.name:
+        target.name = incoming.name
+    if not target.approval_status and incoming.approval_status:
+        target.approval_status = incoming.approval_status
+
+
+def deduplicate(candidates: Iterable[LigandCandidate]) -> list[LigandCandidate]:
+    """Collapse candidates sharing (for_feature_id, ligand_id) into one, preserving all evidence.
+
+    Order is preserved: the first candidate seen for a dedup_key is kept as the base record and
+    later ones are merged into it, so output order is stable for a given input order.
+    """
+    by_key: dict[tuple[str, str], LigandCandidate] = {}
+    order: list[tuple[str, str]] = []
+    for candidate in candidates:
+        key = candidate.dedup_key
+        if key not in by_key:
+            by_key[key] = candidate
+            order.append(key)
+        else:
+            merge_candidate(by_key[key], candidate)
+    return [by_key[key] for key in order]
diff --git a/s2f/m4_ligands/models.py b/s2f/m4_ligands/models.py
new file mode 100644
index 0000000..2294653
--- /dev/null
+++ b/s2f/m4_ligands/models.py
@@ -0,0 +1,78 @@
+"""Ligand candidate and provenance records for M4 (issue #04, step 1: collect_ligands()).
+
+Field names follow ``docs/04-m4-ligands.md``'s ``ligands[]`` output contract:
+``ligand_id`` (InChIKey), ``name``, ``smiles``, ``source``, ``approval_status``, ``targets_via``,
+``score``, ``components``, ``for_feature_id``, ``rank``.
+
+This module only implements step 1 (``collect_ligands()``) of the doc's six steps. ``score``,
+``components`` and ``rank`` are left ``None`` / empty here — they are step 2's job
+(``score_ligands()``), not built yet. Every candidate is ``status="candidate"`` until scored.
+
+targets_via note
+-----------------
+The doc names four values: ``kg | chembl_homolog | literature | repurposing_set``. That list has
+no value for "ChEMBL activity against the protein's *own* directly-mapped UniProt accession" (as
+opposed to a homolog's) — every ChEMBL-sourced route the doc anticipates is either homolog- or
+KG-derived. Rather than silently forcing a direct match into ``chembl_homolog`` (which would
+misrepresent it as homology-derived when it isn't), this module uses ``chembl_direct`` for that
+case and flags it below. This is an extension of the documented enum, not a substitute for it —
+raise it with the team so ``04-m4-ligands.md`` can be amended one way or the other.
+"""
+
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass, field
+from typing import Any
+
+# Values from docs/04-m4-ligands.md verbatim.
+TARGETS_VIA_KG = "kg"
+TARGETS_VIA_CHEMBL_HOMOLOG = "chembl_homolog"
+TARGETS_VIA_LITERATURE = "literature"
+TARGETS_VIA_REPURPOSING_SET = "repurposing_set"
+# Not in the doc's enum -- see the module docstring's "targets_via note".
+TARGETS_VIA_CHEMBL_DIRECT = "chembl_direct"
+
+
+@dataclass
+class ProvenanceRecord:
+    """One source observation backing a candidate. Multiple records can back one candidate
+    (e.g. a compound found via both a ChEMBL activity row and a ChEMBL mechanism row)."""
+
+    source: str
+    source_record_id: str
+    retrieved_at: str
+    evidence_type: str
+    source_url: str = ""
+    description: str = ""
+
+    def as_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+@dataclass
+class LigandCandidate:
+    """One protein-ligand candidate. Deduplication key is (for_feature_id, ligand_id)."""
+
+    for_feature_id: str
+    ligand_id: str  # canonical InChIKey
+    canonical_smiles: str
+    name: str = ""
+    source: list[str] = field(default_factory=list)  # e.g. ["chembl"]; grows as sources merge
+    approval_status: str = ""  # "" | "approved" | "investigational" | "purchasable" | ...
+    targets_via: list[str] = field(default_factory=list)  # subset of the TARGETS_VIA_* constants
+    proposal_reason: list[dict[str, Any]] = field(default_factory=list)
+    provenance: list[ProvenanceRecord] = field(default_factory=list)
+    activity_evidence: list[dict[str, Any]] = field(default_factory=list)
+    score: float | None = None  # step 2, not implemented here
+    components: dict[str, float] = field(default_factory=dict)  # step 2, not implemented here
+    rank: int | None = None  # step 3, not implemented here
+    status: str = "candidate"
+
+    @property
+    def dedup_key(self) -> tuple[str, str]:
+        return (self.for_feature_id, self.ligand_id)
+
+    def as_dict(self) -> dict[str, Any]:
+        payload = asdict(self)
+        payload["provenance"] = [p.as_dict() if isinstance(p, ProvenanceRecord) else p for p in self.provenance]
+        return payload
diff --git a/s2f/m4_ligands/normalize.py b/s2f/m4_ligands/normalize.py

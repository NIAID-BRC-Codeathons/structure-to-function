@@ -0,0 +1,265 @@
+"""Tests for s2f.m4_ligands.sources.chembl. Response shapes are trimmed real ChEMBL API shapes."""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from s2f.common.http import CachedJsonClient, JsonCache
+from s2f.m4_ligands.models import TARGETS_VIA_CHEMBL_DIRECT, TARGETS_VIA_CHEMBL_HOMOLOG
+from s2f.m4_ligands.sources.chembl import collect_from_chembl
+
+ASPIRIN_SMILES = "CC(=O)Oc1ccccc1C(=O)O"
+IBUPROFEN_SMILES = "CC(C)Cc1ccc(cc1)C(C)C(=O)O"
+
+
+class FakeResponse:
+    def __init__(self, payload, status_code: int = 200) -> None:
+        self.status_code = status_code
+        self._payload = payload
+        self.content = json.dumps(payload).encode()
+        self.text = self.content.decode()
+        self.headers: dict[str, str] = {}
+
+    @property
+    def ok(self) -> bool:
+        return 200 <= self.status_code < 300
+
+    def json(self):
+        return self._payload
+
+
+class FakeSession:
+    """Routes GET calls to canned ChEMBL-shaped responses by URL substring."""
+
+    def __init__(self, routes: dict[str, dict]) -> None:
+        self.routes = routes
+        self.calls: list[tuple[str, dict]] = []
+        self.headers: dict[str, str] = {}
+
+    def get(self, url, params=None, timeout=None):
+        params = params or {}
+        self.calls.append((url, params))
+        for needle, payload in self.routes.items():
+            if needle in url:
+                return FakeResponse(payload)
+        raise AssertionError(f"unexpected URL in test: {url} {params}")
+
+
+def make_client(tmp_path, routes) -> tuple[CachedJsonClient, FakeSession]:
+    session = FakeSession(routes)
+    cache = JsonCache(tmp_path / "cache.sqlite")
+    client = CachedJsonClient(cache=cache, session=session, min_interval_seconds=0)
+    return client, session
+
+
+def test_fast_path_uses_pre_resolved_target_and_skips_target_lookup(tmp_path) -> None:
+    client, session = make_client(
+        tmp_path,
+        {
+            "mechanism.json": {"mechanisms": []},
+            "activity.json": {
+                "activities": [
+                    {
+                        "activity_id": 1,
+                        "molecule_chembl_id": "CHEMBL545",
+                        "pchembl_value": "7.2",
+                        "assay_chembl_id": "CHEMBL_ASSAY_1",
+                        "standard_type": "Ki",
+                        "standard_value": "63",
+                        "standard_units": "nM",
+                    }
+                ]
+            },
+            "molecule.json": {
+                "molecules": [
+                    {
+                        "molecule_chembl_id": "CHEMBL545",
+                        "pref_name": "ASPIRIN",
+                        "max_phase": 4,
+                        "molecule_structures": {"canonical_smiles": ASPIRIN_SMILES},
+                    }
+                ]
+            },
+        },
+    )
+
+    candidates, failures = collect_from_chembl(
+        client, feature_id="fig|1", target_chembl_id="CHEMBL2095233", via_homolog=False
+    )
+
+    assert failures == []
+    assert len(candidates) == 1
+    assert candidates[0].approval_status == "approved"
+    assert candidates[0].targets_via == [TARGETS_VIA_CHEMBL_DIRECT]
+    # No target.json call at all -- the fast path never looks one up.
+    assert not any("target.json" in url for url, _ in session.calls)
+
+
+def test_via_homolog_flag_selects_the_homolog_targets_via_value(tmp_path) -> None:
+    client, _ = make_client(
+        tmp_path,
+        {
+            "mechanism.json": {"mechanisms": []},
+            "activity.json": {"activities": []},
+            "molecule.json": {"molecules": []},
+        },
+    )
+
+    candidates, _ = collect_from_chembl(
+        client, feature_id="fig|1", target_chembl_id="CHEMBL2095233", via_homolog=True
+    )
+    assert candidates == []  # nothing to assert on targets_via with zero results; see next test
+
+
+def test_mechanism_and_activity_referencing_the_same_molecule_both_appear_as_raw_candidates(tmp_path) -> None:
+    """dedup.py is responsible for merging these; the connector itself emits one candidate per
+    evidence row, which is the raw-observation count the run.json report needs."""
+    client, _ = make_client(
+        tmp_path,
+        {
+            "mechanism.json": {
+                "mechanisms": [
+                    {"mechanism_id": 1, "molecule_chembl_id": "CHEMBL545", "mechanism_of_action": "COX inhibitor"}
+                ]
+            },
+            "activity.json": {
+                "activities": [
+                    {
+                        "activity_id": 2,
+                        "molecule_chembl_id": "CHEMBL545",
+                        "pchembl_value": "7.2",
+                        "assay_chembl_id": "A1",
+                        "standard_type": "Ki",
+                        "standard_value": "63",
+                        "standard_units": "nM",
+                    }
+                ]
+            },
+            "molecule.json": {
+                "molecules": [
+                    {
+                        "molecule_chembl_id": "CHEMBL545",
+                        "pref_name": "ASPIRIN",
+                        "max_phase": 4,
+                        "molecule_structures": {"canonical_smiles": ASPIRIN_SMILES},
+                    }
+                ]
+            },
+        },
+    )
+
+    candidates, failures = collect_from_chembl(
+        client, feature_id="fig|1", target_chembl_id="CHEMBL2095233", via_homolog=False
+    )
+
+    assert failures == []
+    assert len(candidates) == 2  # one from mechanism, one from activity -- not yet deduplicated
+    assert {c.ligand_id for c in candidates} == {"BSYNRYMUTXBXSQ-UHFFFAOYSA-N"}
+
+
+def test_fallback_path_looks_up_target_by_uniprot_accession(tmp_path) -> None:
+    client, session = make_client(
+        tmp_path,
+        {
+            "target.json": {"targets": [{"target_chembl_id": "CHEMBL4523582"}]},
+            "mechanism.json": {"mechanisms": []},
+            "activity.json": {"activities": []},
+            "molecule.json": {"molecules": []},
+        },
+    )
+
+    candidates, failures = collect_from_chembl(
+        client, feature_id="fig|1", target_chembl_id=None, uniprot_accession="P0DTC2", via_homolog=False
+    )
+
+    assert failures == []
+    assert any("target.json" in url for url, _ in session.calls)
+
+
+def test_fallback_with_no_uniprot_accession_is_a_recorded_failure_not_a_crash(tmp_path) -> None:
+    client, _ = make_client(tmp_path, {})
+
+    candidates, failures = collect_from_chembl(
+        client, feature_id="fig|1", target_chembl_id=None, uniprot_accession="", via_homolog=False
+    )
+
+    assert candidates == []
+    assert len(failures) == 1
+    assert failures[0]["feature_id"] == "fig|1"
+
+
+def test_no_chembl_target_for_accession_is_a_genuine_empty_result_not_a_failure(tmp_path) -> None:
+    client, _ = make_client(tmp_path, {"target.json": {"targets": []}})
+
+    candidates, failures = collect_from_chembl(
+        client, feature_id="fig|1", target_chembl_id=None, uniprot_accession="Q99999", via_homolog=False
+    )
+
+    assert candidates == []
+    assert failures == []  # ChEMBL genuinely has no target for this accession -- not an error
+
+
+def test_max_phase_filter_excludes_below_threshold_candidates(tmp_path) -> None:
+    client, _ = make_client(
+        tmp_path,
+        {
+            "mechanism.json": {"mechanisms": []},
+            "activity.json": {
+                "activities": [
+                    {
+                        "activity_id": 1,
+                        "molecule_chembl_id": "CHEMBL_INVESTIGATIONAL",
+                        "pchembl_value": "6.0",
+                        "assay_chembl_id": "A1",
+                        "standard_type": "IC50",
+                        "standard_value": "500",
+                        "standard_units": "nM",
+                    }
+                ]
+            },
+            "molecule.json": {
+                "molecules": [
+                    {
+                        "molecule_chembl_id": "CHEMBL_INVESTIGATIONAL",
+                        "pref_name": "INVESTIGATIONAL-COMPOUND",
+                        "max_phase": 2,
+                        "molecule_structures": {"canonical_smiles": IBUPROFEN_SMILES},
+                    }
+                ]
+            },
+        },
+    )
+
+    candidates, _ = collect_from_chembl(
+        client, feature_id="fig|1", target_chembl_id="CHEMBL2095233", via_homolog=False, max_phase=4
+    )
+
+    assert candidates == []  # phase 2 < required phase 4
+
+
+def test_molecule_with_no_smiles_is_recorded_as_a_failure_not_silently_dropped(tmp_path) -> None:
+    client, _ = make_client(
+        tmp_path,
+        {
+            "mechanism.json": {
+                "mechanisms": [{"mechanism_id": 1, "molecule_chembl_id": "CHEMBL_NO_SMILES", "mechanism_of_action": "x"}]
+            },
+            "activity.json": {"activities": []},
+            "molecule.json": {
+                "molecules": [
+                    {"molecule_chembl_id": "CHEMBL_NO_SMILES", "pref_name": "NO-STRUCTURE", "max_phase": 1,
+                     "molecule_structures": {}}
+                ]
+            },
+        },
+    )
+
+    candidates, failures = collect_from_chembl(
+        client, feature_id="fig|1", target_chembl_id="CHEMBL2095233", via_homolog=False
+    )
+
+    assert candidates == []
+    assert len(failures) == 1
+    assert "smiles" in failures[0]["error"].lower()

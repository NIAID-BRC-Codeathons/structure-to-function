index 0000000..08b058c
--- /dev/null
+++ b/s2f/m4_ligands/normalize.py
@@ -0,0 +1,44 @@
+"""RDKit canonicalization for M4 ligand candidates.
+
+Every candidate is re-canonicalized here regardless of source, so a compound reported by ChEMBL
+and one reported by PubChem/ZINC land on the same InChIKey when they're the same molecule. A
+source's own standardization (e.g. ChEMBL's ``standard_inchi_key``) is kept in provenance as a
+cross-check, not used as the dedup key itself, precisely so a disagreement is visible rather than
+silently trusted.
+
+Caution (per the M4 doc and the project's own review of this pattern): standard InChIKeys do not
+distinguish every chemically relevant representation -- salts, mixtures, stereochemistry and
+tautomers can collapse together. ``normalize_smiles`` raises rather than guesses on unparseable
+input; it does not attempt salt-stripping or tautomer canonicalization beyond what
+``Chem.MolToSmiles``/``inchi.MolToInchiKey`` do by default.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from rdkit import Chem
+from rdkit.Chem import inchi
+
+
+class InvalidSmiles(ValueError):
+    """Raised when a source record's SMILES cannot be parsed by RDKit."""
+
+
+@dataclass
+class NormalizedStructure:
+    canonical_smiles: str
+    inchikey: str
+
+
+def normalize_smiles(smiles: str) -> NormalizedStructure:
+    mol = Chem.MolFromSmiles(smiles)
+    if mol is None:
+        raise InvalidSmiles(f"RDKit could not parse SMILES: {smiles!r}")
+
+    canonical_smiles = Chem.MolToSmiles(mol, canonical=True)
+    inchikey = inchi.MolToInchiKey(mol)
+    if not inchikey or inchikey.startswith("InChI="):
+        raise InvalidSmiles(f"RDKit could not compute an InChIKey for SMILES: {smiles!r}")
+
+    return NormalizedStructure(canonical_smiles=canonical_smiles, inchikey=inchikey)

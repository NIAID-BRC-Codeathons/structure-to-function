+"""End-to-end check: `python -m s2f.m4_ligands.cli --dry-run` works from fixtures/m4, no network.
+
+Mirrors the acceptance-check pattern from M2's test_m2_dry_run.py.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from s2f.m4_ligands.cli import main
+
+
+def _read_jsonl(path: Path) -> list[dict]:
+    with path.open(encoding="utf-8") as handle:
+        return [json.loads(line) for line in handle if line.strip()]
+
+
+def test_dry_run_produces_deduplicated_candidates_with_provenance(tmp_path: Path) -> None:
+    run_dir = tmp_path / "run"
+    assert main(["--dry-run", "--run", str(run_dir)]) == 0
+
+    out = run_dir / "m4_ligands"
+    candidates = _read_jsonl(out / "ligand_candidates.jsonl")
+    provenance = _read_jsonl(out / "provenance.jsonl")
+    manifest = json.loads((out / "run.json").read_text())
+
+    assert manifest["offline"] is True
+    assert manifest["dry_run"] is True
+    assert manifest["counts"]["proteins_considered"] == 3
+    assert manifest["counts"]["proteins_skipped_no_mapping"] == 1
+    assert manifest["skipped_no_mapping"] == ["fig|999999.1.peg.3"]
+
+    # fig|...peg.1 has one molecule referenced by both a mechanism and an activity row --
+    # dedup must collapse those into one candidate, not two.
+    assert manifest["counts"]["candidates_raw"] == 3
+    assert manifest["counts"]["candidates_deduplicated"] == 2
+
+    by_feature = {c["for_feature_id"]: c for c in candidates}
+    assert set(by_feature) == {"fig|999999.1.peg.1", "fig|999999.1.peg.2"}
+    assert len(by_feature["fig|999999.1.peg.1"]["provenance"]) == 2
+    assert by_feature["fig|999999.1.peg.2"]["approval_status"] == "approved"
+
+    # Every candidate is traceable: provenance.jsonl carries feature_id + ligand_id + source.
+    assert len(provenance) == 3  # 2 records for peg.1, 1 for peg.2 -- pre-dedup observation count
+    assert all({"feature_id", "ligand_id", "source", "source_record_id"} <= set(p) for p in provenance)
+
+
+def test_dry_run_reports_per_source_unique_vs_observation_counts(tmp_path: Path) -> None:
+    run_dir = tmp_path / "run"
+    main(["--dry-run", "--run", str(run_dir)])
+    manifest = json.loads((run_dir / "m4_ligands" / "run.json").read_text())
+
+    chembl_counts = manifest["counts"]["by_source"]["chembl"]

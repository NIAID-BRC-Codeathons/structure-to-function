# Run outputs and working data (see docs/00-architecture.md)
runs/
data/

# Credentials — never commit
.env
.env.*
*.token
.patric_token

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp

# Large tool outputs that should be regenerated, not committed
*.pdbqt
!fixtures/**/*.pdbqt

# Some contributors' global excludes (core.excludesFile) carry a blanket `docs/` rule
# from data-science templates where docs/ is generated. Here it is source and must be
# tracked -- without these two lines `git add -A` silently drops every new doc and figure
# on those machines while reporting a clean tree. A repository-level negation overrides
# the global file; it is a no-op for anyone who does not have that rule.
!docs/
!docs/**
